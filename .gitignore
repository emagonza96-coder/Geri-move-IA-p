*.pyd

# Calibración estéreo (se genera en cada setup)
calibration.json

# Capturas de pantalla sueltas
*.png

# Archivos de sistema
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs y temporales
*.log
*.tmp
